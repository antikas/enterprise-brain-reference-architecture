# View 2: logical components and the paths for requests and claims.
direction: down

style.fill: "#faf7f2"

classes: {
  spine-band: {
    style: {
      fill: "#1e2a24"
      stroke: "#1e2a24"
      font-color: "#f2ede4"
      border-radius: 12
      font-size: 15
      bold: true
    }
  }
  spine-col: {
    style: {
      fill: "#2c3b33"
      stroke: "#4b5e53"
      font-color: "#f2ede4"
      border-radius: 9
      font-size: 12
    }
  }
  band: {
    style: {
      fill: "#f4efe6"
      stroke: "#c8bfad"
      border-radius: 12
      font-color: "#3a3529"
      font-size: 14
      bold: true
    }
  }
  kband: {
    style: {
      fill: "#eef4ef"
      stroke: "#4a7b5e"
      border-radius: 12
      font-color: "#22352a"
      font-size: 14
      bold: true
    }
  }
  oband: {
    style: {
      fill: "#eef1f6"
      stroke: "#5b6e8c"
      border-radius: 12
      font-color: "#26313f"
      font-size: 14
      bold: true
    }
  }
  knowledge: {
    style: {
      fill: "#e7efe8"
      stroke: "#4a7b5e"
      border-radius: 9
      font-color: "#22352a"
      font-size: 12
    }
  }
  operational: {
    style: {
      fill: "#e9edf3"
      stroke: "#5b6e8c"
      border-radius: 9
      font-color: "#26313f"
      font-size: 12
    }
  }
  control: {
    style: {
      fill: "#efe8dc"
      stroke: "#9a8768"
      border-radius: 9
      font-color: "#3a3123"
      font-size: 12
    }
  }
  plain: {
    style: {
      fill: "#fffdf9"
      stroke: "#c9c2b4"
      border-radius: 9
      font-color: "#33312c"
      font-size: 12
    }
  }
  store: {
    shape: cylinder
    style: {
      fill: "#1e2a24"
      stroke: "#1e2a24"
      font-color: "#f2ede4"
      font-size: 12
    }
  }
  ctrlstore: {
    shape: cylinder
    style: {
      fill: "#5d503b"
      stroke: "#5d503b"
      font-color: "#f6f0e4"
      font-size: 12
    }
  }
  gate: {
    style: {
      fill: "#fffdf9"
      stroke: "#a8452c"
      stroke-width: 2
      border-radius: 14
      font-color: "#3a2118"
      font-size: 13
    }
  }
  badge: {
    style: {
      fill: "#1e2a24"
      stroke: "#1e2a24"
      font-color: "#f2ede4"
      border-radius: 8
      font-size: 11
    }
  }
  decision: {
    shape: diamond
    style: {
      fill: "#fdf6e9"
      stroke: "#b79a56"
      font-color: "#3d3116"
      font-size: 12
    }
  }
  k-path: {
    style: {
      stroke: "#4a7b5e"
      stroke-width: 2
      font-color: "#2e4a3a"
      font-size: 11
    }
  }
  o-path: {
    style: {
      stroke: "#5b6e8c"
      stroke-width: 2
      stroke-dash: 4
      font-color: "#3b4a60"
      font-size: 11
    }
  }
  c-path: {
    style: {
      stroke: "#9a8768"
      stroke-width: 1
      stroke-dash: 2
      font-color: "#6b5c44"
      font-size: 11
    }
  }
  gate-path: {
    style: {
      stroke: "#a8452c"
      stroke-width: 2
      font-color: "#7d3320"
      font-size: 11
    }
  }
  foot: {
    shape: text
    style: {
      font-size: 12
      font-color: "#5c574d"
    }
  }
}

spine: "DETERMINISTIC SPINE: rules over recorded evidence govern claims, actions and release." {
  class: spine-band
  near: top-center
  grid-columns: 5
  grid-gap: 16
  s1: "One way into L0\nC-G3.2" { class: spine-col }
  s2: "Lineage travels in the record\nC-G3.3" { class: spine-col }
  s3: "Named human verdict\nC-G5.2" { class: spine-col }
  s4: "Durable before visible\nC-X3" { class: spine-col }
  s5: "One way out\nC-G4.8" { class: spine-col }
}

sources: "SOURCE REACH (C-G1.6): each source has a materiality rating, a sensitivity rating and one information plane. Missing allocation fails configuration." {
  class: band
  grid-columns: 3
  grid-gap: 16
  ingest: "Knowledge ingest\ndocuments, records, conversations,\nstated policy: material the brain\ntakes into its own corpus" { class: knowledge }
  federate: "Operational federation\na ledger, a customer system, an order\nbook: reached live, and left\nauthoritative where it sits" { class: operational }
  capture: "Human capture\ntacit knowledge a person proposes,\nconfirmed before it counts" { class: knowledge }
}

admission: "Claim admission (C-G3.2)\nA person approves each semantic claim before it enters L0.\nContradictions wait for review. Derived views rebuild from recorded sources." {
  class: gate
  spinebadge: "SPINE CONTROL · claim admission" { class: badge }
}

l0: "Knowledge source of truth (L0)\nconfirmed semantic claims" { class: store }

control: "Governed control state\nontology · policy · registries · alias-review decisions\nsurvivorship verdicts · lineage stamps · oversight verdicts\nrelease and refusal records · observation serving status" { class: ctrlstore }

kviews: "KNOWLEDGE VIEWS: generated from L0" {
  class: kband
  grid-columns: 4
  grid-gap: 14
  index: "Lexical and vector indexes\nwhat recall reads (C-G2.1)" { class: knowledge }
  cluster: "Signatures and clusters\nrules find recurring structure" { class: knowledge }
  obs: "Observations (C-G2.3)\nstructure decided by algorithm, prose\nbounded to the evidence it cites;\nactive, held or retired" { class: knowledge }
  digest: "Knowledge summaries\ngenerated from L0" { class: knowledge }
}

oviews: "OPERATIONAL VIEWS: live queries or declared projections. Each projection carries a build stamp, reconciliation result, source path and freshness state. Recall reads the knowledge plane." {
  class: oband
  grid-columns: 3
  grid-gap: 14
  master: "One enterprise entity master (C-G3.4)\nthe shared entity across soft unit\nscopes resolves once" { class: operational }
  insight: "Consolidated operational insight\nevery answer carries its path and\nits freshness" { class: operational }
  product: "Generated data products (C-G2.5)\ndeclarative, conformance-tested against\nthe contracts C-G2.6 governs" { class: operational }
}

intent: "Intent routing (C-G2.4)\nselects allowed evidence surfaces for the request\nrecall · observations · live federation · consolidated insight · governed ad-hoc read\nA model can propose a route. Rules check the proposal against the allow-list." { class: decision }

compose: "Compose the evidence (C-G2.2)\ndeterministic, budgeted slots" { class: plain }

reasoning: "Reasoning routing (C-X1)\nselects a reasoning tier after evidence assembly" { class: decision }

specialist: "Specialist inventory (C-X2)\nregistered models for recurring tasks" { class: plain }

frontier: "General orchestrator\nhandles novel and broad tasks through\na replaceable interface" { class: plain }

durable: "Durable agent work (C-X3)\nA task-keyed journal stores nested intent and result units. Intent is saved before\nan effect. The result is saved before emission, acknowledgement or offset advance.\nApproval waits and effect settlement records survive process loss. Recovery uses\nthe effect class. An uncertain non-idempotent outcome goes to reconciliation." {
  class: gate
  spinebadge: "SPINE CONTROL · durable work" { class: badge }
}

verdicts: "RELEASE INPUTS: each service supplies its own recorded verdict" {
  class: band
  grid-columns: 5
  grid-gap: 14
  subject: "Verified subject and access\nC-G4.1" { class: control }
  minimise: "Minimisation and egress\nC-G4.4" { class: control }
  qpolicy: "Query policy across dialects\nC-G4.9 · fail-closed" { class: control }
  basis: "Consent or lawful basis\nC-G5.8 · purpose-bound" { class: control }
  oversight: "Human oversight verdict\nC-G5.2" { class: control }
}

release: "Governed release (C-G4.8)\nThe single external egress path over the answer-surface registry. It classifies each\nregistered surface protected or unprotected, defaults an absent or unrecognised\nclassification to protected-and-refused, consumes the named verdicts atomically, and\npersists its own authoritative release-or-refusal record before any byte is emitted." {
  class: gate
  spinebadge: "SPINE CONTROL · registered release path" { class: badge }
}

consumer: "The acting user, or a calling service" {
  shape: oval
  class: plain
}

evidence: "Decision-record reconstruction (C-G5.3)\nprojects the release records and workflow events\nheld by their owning services" { class: control }

sources.ingest -> admission: "candidate claim, classified and staged" { class: k-path }
sources.capture -> admission: "confirmed capture" { class: k-path }
admission -> l0: "admitted" { class: gate-path }
admission -> control: "hold, override and admission decisions" { class: c-path }
l0 -> kviews: "builds" { class: k-path }
sources.federate -> oviews: "reached live; materialised only on an explicit dial" { class: o-path }
control -> oviews: "governs what may be materialised, and on what terms" { class: c-path }
control -> kviews: "serving status, held and retired" { class: c-path }

kviews -> intent: "evidence the knowledge plane can offer" { class: k-path }
oviews -> intent: "answers the operational plane can offer, with path and freshness" { class: o-path }
intent -> compose: "the chosen surfaces, and the routing claim recorded" { class: k-path }
compose -> reasoning: "assembled evidence" { class: k-path }
reasoning -> specialist: "a specialist fits, and clears its gate" { class: k-path }
reasoning -> frontier: "novel, or out of corpus" { class: k-path }
specialist -> release: "internal candidate answer" { class: gate-path }
frontier -> release: "internal candidate answer" { class: gate-path }
verdicts.subject -> release: "verified subject and access" { class: gate-path }
verdicts.minimise -> release: "minimum allowed content" { class: gate-path }
verdicts.qpolicy -> release: "query policy verdict" { class: gate-path }
verdicts.basis -> release: "current lawful basis" { class: gate-path }
verdicts.oversight -> release: "human oversight verdict" { class: gate-path }
release -> consumer: "the answer, its trust signals, and a record persisted before it left" { class: gate-path }
release -> control: "the authoritative release or refusal record" { class: c-path }
control -> evidence: "projected from" { class: c-path }

durable -> reasoning: "hosts the multi-step work" { class: c-path }
durable -> admission: "persists the approval wait, and resumes on the verdict" { class: c-path }
durable -> release: "agent-backed answers reference the release record" { class: c-path }
verdicts.oversight -> durable: "the verdict is recorded here, and waited on here" { class: c-path }

legend: "Legend. The dark band shows shared truth controls. Green shows the knowledge plane. Blue-grey shows the operational plane. Sand shows governed\ncontrol state. A red rule marks a control point. Every consumer path passes through governed release. Colours and line styles show design roles." {
  class: foot
  near: bottom-center
}
