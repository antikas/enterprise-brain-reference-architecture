# View 5: learning the business and running durable work.
direction: down

style.fill: "#faf7f2"

classes: {
  spine-band: {
    style: {
      fill: "#1e2a24"
      stroke: "#1e2a24"
      font-color: "#f2ede4"
      border-radius: 12
      font-size: 15
      bold: true
    }
  }
  spine-col: {
    style: {
      fill: "#2c3b33"
      stroke: "#4b5e53"
      font-color: "#f2ede4"
      border-radius: 9
      font-size: 12
    }
  }
  band: {
    style: {
      fill: "#f4efe6"
      stroke: "#c8bfad"
      border-radius: 12
      font-color: "#3a3529"
      font-size: 14
      bold: true
    }
  }
  operational: {
    style: {
      fill: "#e9edf3"
      stroke: "#5b6e8c"
      border-radius: 9
      font-color: "#26313f"
      font-size: 12
    }
  }
  control: {
    style: {
      fill: "#efe8dc"
      stroke: "#9a8768"
      border-radius: 9
      font-color: "#3a3123"
      font-size: 12
    }
  }
  plain: {
    style: {
      fill: "#fffdf9"
      stroke: "#c9c2b4"
      border-radius: 9
      font-color: "#33312c"
      font-size: 12
    }
  }
  store: {
    shape: cylinder
    style: {
      fill: "#1e2a24"
      stroke: "#1e2a24"
      font-color: "#f2ede4"
      font-size: 12
    }
  }
  gate: {
    style: {
      fill: "#fffdf9"
      stroke: "#a8452c"
      stroke-width: 2
      border-radius: 14
      font-color: "#3a2118"
      font-size: 13
    }
  }
  badge: {
    style: {
      fill: "#1e2a24"
      stroke: "#1e2a24"
      font-color: "#f2ede4"
      border-radius: 8
      font-size: 11
    }
  }
  alarm: {
    style: {
      fill: "#f6e3dd"
      stroke: "#a8452c"
      stroke-width: 2
      border-radius: 9
      font-color: "#4a2118"
      font-size: 12
    }
  }
  k-path: {
    style: {
      stroke: "#4a7b5e"
      stroke-width: 2
